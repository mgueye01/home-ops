---
machine:
  network:
    hostname: k8s-3
    interfaces:
      - deviceSelector:
          busPath: "1-1.0"  # TB -> k8s-1
        dhcp: false
        mtu: 65520
        addresses:
          - 10.0.100.4/24
        routes:
          - network: 10.0.100.1/32
          - network: 10.0.100.3/32
          - network: 10.0.101.1/32  # k8s-1 OSD cluster addr (dummy0)
            gateway: 10.0.100.3
      - deviceSelector:
          busPath: "0-1.0"  # TB -> k8s-2
        dhcp: false
        mtu: 65520
        addresses:
          - 10.0.100.6/24
        routes:
          - network: 10.0.100.2/32
          - network: 10.0.100.5/32
          - network: 10.0.101.2/32  # k8s-2 OSD cluster addr (dummy0)
            gateway: 10.0.100.5
      - interface: dummy0  # stable Ceph cluster_network address, survives TB4 link loss
        dummy: true
        addresses:
          - 10.0.101.3/32
  nodeLabels:
    topology.kubernetes.io/zone: m
  type: controlplane
