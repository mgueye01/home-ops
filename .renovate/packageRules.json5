{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Loose versioning for non-semver containers"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/plex/"],
      "versioning": "loose"
    },
    {
      // Talos drives the Kubernetes upgrade via `talosctl upgrade-k8s`, and it
      // refuses any path it does not know: "unsupported upgrade path 1.36->1.37".
      // Talos v1.13.x (latest as of 2026-08-31) ships Kubernetes 1.36, so a 1.37
      // bump produces a plan the cluster can never apply -- the SUC job fails in
      // seconds and retries until it hits jobActiveDeadlineSecs.
      // Raise this ceiling only once a Talos release supporting 1.37 is out.
      "description": ["Cap Kubernetes images at what the running Talos release supports"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler"
      ],
      "allowedVersions": "<1.37"
    },
    {
      // Talos v1.13.10 (kernel 6.18.48) corrupts thunderbolt-net frames on the
      // transmit side: every peer of a node running it sees ~0.2 % rx CRC
      // errors on the TB4 Ceph mesh, and CephNodeNetworkPacketErrors flaps.
      // Bisected on 2026-09-04 by downgrading a single node to v1.13.9 (kernel
      // 6.18.44): its peers dropped to 0 errors in 550k frames while the links
      // between the two v1.13.10 nodes kept failing. v1.13.11 (kernel 6.18.54)
      // has the same bug: errors went from 0 to ~16k/h on all six links at the
      // 2026-10-01 rollout. Verify any new release on one node before
      // widening this.
      "description": ["Skip Talos v1.13.10 and v1.13.11, which corrupt thunderbolt-net on transmit"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/siderolabs/installer"],
      "allowedVersions": "!/^v?1\\.13\\.1[01]$/"
    }
  ]
}
